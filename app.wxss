page {
  min-height: 100%;
  background: #f5f7fb;
  color: #202733;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  text-align: center;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.primary-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 32rpx;
  line-height: 1;
}

.ghost-button {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1677ff;
  border: 1rpx solid #d6e4ff;
  font-size: 30rpx;
  line-height: 1;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #8a94a6;
  font-size: 28rpx;
}
