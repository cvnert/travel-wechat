<view class="profile-page">
  <view class="member-hero">
    <view class="member-card">
      <view class="member-top">
        <view class="avatar-wrap" bindtap="handleLoginTap">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">{{avatarText}}</view>
        </view>

        <view class="member-info" bindtap="handleLoginTap">
          <view class="member-badge">{{memberBadgeText}}</view>
          <view class="member-name">{{memberNameText}}</view>
          <view class="member-desc">{{memberDescText}}</view>
        </view>
      </view>

      <view class="member-actions member-actions-single" wx:if="{{showLoginButton}}">
        <button class="member-primary-button" loading="{{loginLoading}}" bindtap="wechatLogin">微信登录</button>
      </view>

      <view class="member-actions" wx:if="{{isLoggedIn}}">
        <button class="member-primary-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" loading="{{profileLoading}}">更新头像</button>
        <button wx:if="{{showLogoutButton}}" class="member-secondary-button" bindtap="logout">退出登录</button>
      </view>

      <view class="member-shortcuts">
        <view
          class="member-shortcut"
          wx:for="{{memberShortcuts}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="handleOrderShortcut"
        >
          <view class="member-shortcut-icon">
            <image class="member-shortcut-icon-image" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <view class="member-shortcut-title">{{item.title}}</view>
          <view class="member-shortcut-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="feature-card cart-card" bindtap="openCart">
    <view class="row-left">
      <view class="row-icon">
        <image class="row-icon-image" src="{{cartIcon}}" mode="aspectFit"></image>
      </view>
      <view class="row-copy">
        <view class="row-title">购物车</view>
        <view class="row-desc">已选行程和套餐都在这里统一结算</view>
      </view>
    </view>
    <view class="row-right">
      <text>去结算</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="query-card" bindtap="openOrders">
    <view class="query-label">订单查询</view>
    <view class="query-title">待支付、待出行、已出行一眼看清</view>
    <view class="query-desc">支付后查看凭证和出行状态都会更方便</view>
  </view>

  <view class="order-card">
    <view class="card-head">
      <view class="card-title">我的订单</view>
      <view class="card-link" bindtap="openOrders">查看全部订单 ›</view>
    </view>
    <view class="order-grid">
      <view class="order-item" wx:for="{{orderItems}}" wx:key="key" data-key="{{item.key}}" bindtap="handleOrderShortcut">
        <view class="order-icon">
          <image class="order-icon-image" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="order-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view
      class="menu-row"
      wx:for="{{menuItems}}"
      wx:key="key"
      bindtap="openOrders"
      data-status="{{item.status}}"
    >
      <view class="row-left">
        <view class="row-icon">
          <image class="row-icon-image" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="row-title">{{item.title}}</view>
      </view>
      <view class="chevron">›</view>
    </view>
  </view>
</view>
