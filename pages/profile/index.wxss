.profile-page {
  min-height: 100vh;
  padding: 24rpx 18rpx 36rpx;
  background:
    linear-gradient(180deg, #f7f8fb 0%, #f2f5f9 52%, #eef2f6 100%);
  color: #111827;
  box-sizing: border-box;
}

.member-hero {
  margin-bottom: 18rpx;
}

.member-card {
  position: relative;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 219, 172, 0.34), rgba(255, 219, 172, 0) 30%),
    linear-gradient(135deg, #124e4a 0%, #195d69 58%, #c79252 100%);
  box-shadow: 0 20rpx 44rpx rgba(15, 23, 42, 0.12);
  overflow: hidden;
}

.member-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.member-top,
.member-actions,
.member-shortcuts {
  position: relative;
  z-index: 1;
}

.member-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar-wrap {
  width: 118rpx;
  height: 118rpx;
  flex: 0 0 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(244, 247, 251, 0.92));
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: inset 0 4rpx 12rpx rgba(255, 255, 255, 0.42);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f766e;
  font-size: 42rpx;
  font-weight: 700;
}

.member-info {
  flex: 1;
  min-width: 0;
  color: #ffffff;
}

.member-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  font-weight: 600;
}

.member-name {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.5;
}

.member-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.member-actions-single {
  display: block;
}

.member-primary-button,
.member-secondary-button {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.member-primary-button {
  background: #ffffff;
  color: #0f172a;
}

.member-secondary-button {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
}

.member-primary-button::after,
.member-secondary-button::after {
  border: 0;
}

.member-shortcuts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.member-shortcut {
  min-width: 0;
  padding: 18rpx 12rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  text-align: center;
}

.member-shortcut-icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
}

.member-shortcut-icon-image {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.member-shortcut-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.member-shortcut-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 20rpx;
  line-height: 1.3;
}

.feature-card,
.order-card,
.menu-list {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.feature-card,
.menu-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.cart-card {
  margin-bottom: 18rpx;
}

.row-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.row-copy {
  min-width: 0;
}

.row-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f9fbfd 0%, #f1f5f9 100%);
  border: 1rpx solid #dfe7f0;
  flex: 0 0 58rpx;
  box-sizing: border-box;
}

.row-icon-image {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.row-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.row-desc {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #64748b;
  font-size: 26rpx;
  flex-shrink: 0;
}

.chevron {
  color: #94a3b8;
  font-size: 36rpx;
  line-height: 1;
}

.query-card {
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 219, 172, 0.26), rgba(255, 219, 172, 0) 34%),
    linear-gradient(135deg, rgba(16, 78, 74, 0.98) 0%, rgba(22, 78, 99, 0.96) 62%, rgba(201, 147, 83, 0.94) 100%);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.query-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.88);
  font-size: 18rpx;
  font-weight: 600;
}

.query-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.query-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 1.5;
}

.order-card {
  margin-bottom: 18rpx;
  padding: 28rpx 0 30rpx;
  box-sizing: border-box;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 24rpx;
}

.card-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.card-link {
  color: #64748b;
  font-size: 24rpx;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 0 16rpx;
}

.order-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f9fbfd 0%, #f1f5f9 100%);
  border: 1rpx solid #dfe7f0;
  box-sizing: border-box;
}

.order-icon-image {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.order-label {
  margin-top: 12rpx;
  color: #334155;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: center;
}

.menu-list {
  overflow: hidden;
}

.menu-row {
  border-bottom: 1rpx solid #eef2f6;
}

.menu-row:last-child {
  border-bottom: 0;
}
