.profile-page {
  min-height: 100vh;
  padding-bottom: 32rpx;
  background: #f7f3ee;
  color: #111827;
  box-sizing: border-box;
}

.member-hero {
  position: relative;
  height: 310rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #10324f 0%, #214c62 38%, #8b5a2b 100%);
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(11, 25, 42, 0.42), rgba(11, 25, 42, 0.12) 52%, rgba(11, 25, 42, 0.34));
}

.hero-sun {
  position: absolute;
  right: 68rpx;
  top: 44rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 204, 128, 0.95) 0%, rgba(255, 176, 64, 0.6) 44%, rgba(255, 176, 64, 0) 72%);
}

.hero-ridge {
  position: absolute;
  left: -8%;
  right: -8%;
  border-radius: 50% 50% 0 0;
}

.hero-ridge-back {
  bottom: 68rpx;
  height: 112rpx;
  background: #32556a;
  opacity: 0.78;
}

.hero-ridge-front {
  bottom: 26rpx;
  height: 126rpx;
  background: #7a4a25;
  opacity: 0.92;
}

.member-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx 46rpx;
  box-sizing: border-box;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
  overflow: hidden;
}

.avatar-button {
  padding: 0;
  margin: 0;
  border: 0;
  line-height: 1;
}

.avatar-button::after {
  border: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f6f7fb, #dde3ec);
  color: #b4bcc8;
  font-size: 42rpx;
  font-weight: 700;
}

.member-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.member-name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.avatar-edit-button {
  width: 152rpx;
  height: 44rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
}

.avatar-edit-button::after {
  border: 0;
}

.member-code {
  width: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

.code-icon {
  font-size: 42rpx;
  line-height: 1;
}

.code-text {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.login-strip {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding: 0 16rpx 0 28rpx;
  margin: 0 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.login-copy {
  flex: 1;
  min-width: 0;
  color: #1f2937;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.login-button,
.logout-button {
  width: 92rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

.login-button {
  background: #ef4444;
}

.logout-button {
  background: #6b7280;
}

.coupon-row,
.menu-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.coupon-row {
  margin: 0 18rpx;
}

.row-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.row-icon {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid #111827;
  border-radius: 4rpx;
  color: #111827;
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
}

.row-title {
  color: #111827;
  font-size: 28rpx;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #8b95a1;
  font-size: 26rpx;
}

.chevron {
  color: #a0a7b2;
  font-size: 42rpx;
  line-height: 1;
}

.share-banner {
  position: relative;
  height: 178rpx;
  margin: 22rpx 18rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #1f2937 0%, #415a72 38%, #9a6c2d 100%);
}

.share-sun {
  position: absolute;
  left: 44rpx;
  top: 28rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0) 75%);
}

.share-wave {
  position: absolute;
  left: -10%;
  right: -10%;
  border-radius: 50% 50% 0 0;
}

.share-wave-back {
  bottom: 42rpx;
  height: 78rpx;
  background: rgba(255, 255, 255, 0.08);
}

.share-wave-front {
  bottom: 0;
  height: 86rpx;
  background: rgba(0, 0, 0, 0.12);
}

.share-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.04));
}

.share-title {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  align-items: center;
  padding-left: 80rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.36);
}

.order-card {
  margin: 0 18rpx 22rpx;
  padding: 28rpx 0 30rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
}

.card-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 500;
}

.card-link {
  color: #8b95a1;
  font-size: 24rpx;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  margin-top: 34rpx;
}

.order-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #111827;
  border-radius: 8rpx;
  color: #111827;
  font-size: 20rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.order-label {
  margin-top: 12rpx;
  color: #111827;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.menu-list {
  margin: 0 18rpx;
  background: #ffffff;
}

.menu-row {
  border-bottom: 1rpx solid #edf0f2;
}

.menu-row:last-child {
  border-bottom: 0;
}
