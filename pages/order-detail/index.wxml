<view class="detail-page">
  <view wx:if="{{showLoadingState}}" class="empty-card">正在加载订单详情...</view>

  <view wx:elif="{{showMissingState}}" class="empty-card">订单不存在或已失效</view>

  <view wx:if="{{showContent}}">
    <view class="status-card">
      <view>
        <view class="status-label">当前状态</view>
        <view class="status-title">{{order.statusText}}</view>
        <view class="status-desc">订单号 {{order.orderNo}}</view>
      </view>
      <view class="status-badge status-badge-{{order.statusTone}}">{{order.statusText}}</view>
    </view>

    <view wx:if="{{showVoucherCard}}" class="voucher-card">
      <view class="section-title">出行凭证</view>
      <view class="voucher-hint">{{order.voucherHintText}}</view>
      <view class="voucher-code">{{order.verificationCode}}</view>
      <button class="ghost-button copy-button" bindtap="copyVerificationCode">复制凭证码</button>
      <view class="voucher-meta">支付时间 {{order.paidOrCreatedText}}</view>
      <view wx:if="{{order.showVerifiedAt}}" class="voucher-meta">核销时间 {{order.verifiedAtText}}</view>
    </view>

    <view class="info-card">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createdAtText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单金额</text>
        <text class="info-value info-value-strong">{{order.totalAmountText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">商品件数</text>
        <text class="info-value">{{order.totalQuantity}} 件</text>
      </view>
    </view>

    <view class="items-card">
      <view class="section-title">出行商品</view>
      <view wx:for="{{order.items}}" wx:key="id" class="order-item">
        <image class="item-cover" src="{{item.coverDisplayUrl}}" mode="aspectFill" />
        <view class="item-info">
          <view class="item-title">{{item.productTitle}}</view>
          <view class="item-meta">{{item.unitPriceText}} x {{item.quantity}}</view>
          <view wx:if="{{item.travelDate}}" class="item-meta">出发 {{item.travelDate}}</view>
        </view>
        <view class="item-subtotal">{{item.subtotalText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showPendingPaymentBar}}" class="bottom-bar">
    <view class="bottom-copy">
      <view class="bottom-title">完成支付后生成凭证</view>
      <view class="bottom-desc">接入的是真实微信支付，成功后会自动生成凭证并进入待出行状态。</view>
    </view>
    <button class="primary-button bottom-button" loading="{{paying}}" bindtap="payOrder">立即支付</button>
  </view>
</view>
