.cart-page {
  min-height: 100vh;
  padding: 24rpx 20rpx 320rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.empty-card {
  margin-top: 40rpx;
  padding: 44rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  color: #667085;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.empty-card-large {
  margin-top: 88rpx;
}

.empty-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  margin-top: 28rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cart-card {
  display: grid;
  grid-template-columns: auto 148rpx minmax(0, 1fr);
  align-items: start;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.card-select {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-check {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dfc7b0;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.cart-check-active {
  border-color: #ff7a1a;
  background: linear-gradient(135deg, #ff9a52 0%, #ff6a1a 100%);
}

.cart-check-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
}

.media-shell {
  position: relative;
  width: 148rpx;
  height: 148rpx;
}

.cover {
  width: 148rpx;
  height: 148rpx;
  border-radius: 16rpx;
  background: #e5e7eb;
}

.cover-badge {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  max-width: 128rpx;
  padding: 4rpx 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(36, 37, 41, 0.68);
  color: #ffffff;
  font-size: 17rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  min-height: 148rpx;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 48rpx;
}

.title-block {
  flex: 1;
  min-width: 0;
}

.title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.42;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.delete-link {
  min-width: 0;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  color: #ff6a1a;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
  padding-top: 4rpx;
}

.delete-link::after {
  border: 0;
}

.feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.feature-chip {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f6f3ef;
  color: #8a6947;
  font-size: 18rpx;
  line-height: 1.2;
}

.feature-chip-primary {
  background: #fff2e8;
  color: #ff6a1a;
  font-weight: 600;
}

.secure-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
}

.secure-badge {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #1fb75e 0%, #139c4d 100%);
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
}

.secure-text {
  color: #16a34a;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-footer {
  margin-top: auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  padding-top: 14rpx;
}

.price-group {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  min-width: 0;
}

.price {
  color: #ff5000;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.unit-text,
.checkout-label,
.checkout-note,
.select-all-text {
  color: #667085;
  font-size: 22rpx;
}

.unit-text {
  margin-top: 0;
  margin-bottom: 4rpx;
  color: #8f96a3;
  font-size: 20rpx;
  white-space: nowrap;
}

.stepper-shell {
  flex: 0 0 auto;
  padding: 2rpx;
  border: 1rpx solid #ecdaca;
  border-radius: 999rpx;
  background: #fff8f1;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 2rpx;
  width: 176rpx;
  padding: 2rpx;
  border-radius: 999rpx;
  background: transparent;
}

.step-button {
  width: 50rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #91633f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.count {
  flex: 1;
  text-align: center;
  color: #262626;
  font-size: 24rpx;
  font-weight: 600;
}

.recommend-section {
  margin-top: 34rpx;
}

.recommend-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.recommend-line {
  width: 116rpx;
  height: 1rpx;
  background: #d0d5dd;
}

.recommend-title {
  color: #98a2b3;
  font-size: 24rpx;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.recommend-grid-single {
  grid-template-columns: minmax(0, 1fr);
}

.recommend-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.recommend-image {
  width: 100%;
  height: 252rpx;
  display: block;
  background: #e5e7eb;
}

.recommend-body {
  padding: 16rpx 18rpx 20rpx;
}

.recommend-name {
  min-height: 78rpx;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
}

.recommend-price {
  margin-top: 12rpx;
  color: #16a34a;
  font-size: 30rpx;
  font-weight: 700;
}

.checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
  z-index: 20;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
}

.select-all .cart-check {
  margin-top: 0;
}

.checkout-info {
  flex: 1;
  min-width: 0;
}

.checkout-price {
  margin-top: 6rpx;
  color: #ff5000;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.05;
}

.checkout-note {
  margin-top: 6rpx;
}

.checkout-button {
  flex: 0 0 220rpx;
  height: 76rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7a1a 0%, #ff5000 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.checkout-button[disabled] {
  background: #d0d5dd;
  color: #ffffff;
}

.checkout-button::after {
  border: 0;
}
