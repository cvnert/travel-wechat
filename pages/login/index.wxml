<view class="login-page">
  <view class="brand">
    <view class="brand-mark">旅</view>
    <view class="brand-title">旅邦旅游</view>
    <view class="brand-subtitle">精选线路，轻松出行</view>
  </view>

  <view class="form-card">
    <button class="wechat-login-button" loading="{{loading}}" bindtap="wechatLogin">
      微信授权登录
    </button>

    <view class="divider">
      <view class="divider-line"></view>
      <view class="divider-text">账号登录</view>
      <view class="divider-line"></view>
    </view>

    <view class="tabs">
      <view class="tab {{mode === 'login' ? 'active' : ''}}" bindtap="switchLogin">登录</view>
      <view class="tab {{mode === 'register' ? 'active' : ''}}" bindtap="switchRegister">注册</view>
    </view>

    <input class="input" placeholder="账号" value="{{username}}" bindinput="onUsernameInput" />
    <input class="input" placeholder="密码，至少 6 位" password value="{{password}}" bindinput="onPasswordInput" />
    <input wx:if="{{mode === 'register'}}" class="input" placeholder="昵称，可选" value="{{nickname}}" bindinput="onNicknameInput" />

    <button class="primary-button submit" loading="{{loading}}" bindtap="submit">
      {{mode === 'login' ? '登录' : '注册并登录'}}
    </button>
  </view>
</view>
