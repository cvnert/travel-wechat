.login-page {
  min-height: 100vh;
  padding: 96rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #eaf3ff 0%, #f5f7fb 44%, #f5f7fb 100%);
  box-sizing: border-box;
}

.brand {
  margin-bottom: 48rpx;
  text-align: center;
}

.brand-mark {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
}

.brand-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2937;
}

.brand-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #667085;
}

.form-card {
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(16, 24, 40, 0.08);
}

.wechat-login-button {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e7eb;
}

.divider-text {
  color: #98a2b3;
  font-size: 24rpx;
}

.tabs {
  display: flex;
  padding: 6rpx;
  margin-bottom: 28rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #667085;
  font-size: 28rpx;
  text-align: center;
}

.tab.active {
  background: #ffffff;
  color: #1677ff;
  font-weight: 600;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 30rpx;
}

.submit {
  width: 100%;
  margin-top: 12rpx;
}

.wechat-button {
  display: none;
}
