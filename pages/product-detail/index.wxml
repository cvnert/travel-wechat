<view class="detail-page">
  <scroll-view class="detail-scroll" scroll-y="{{detailScrollEnabled}}">
    <swiper class="swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image class="swiper-image" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>

    <view wx:if="{{product}}" class="content">
      <view class="title-row">
        <view class="title">{{product.title}}</view>
        <view wx:if="{{product.tag}}" class="tag">{{product.tag}}</view>
      </view>
      <view wx:if="{{product.hasSummary}}" class="summary">
        {{product.summaryText}}
      </view>
      <view class="meta">
        <view class="price">{{product.priceText}}</view>
        <view class="sales">已售 {{product.salesCount}}</view>
      </view>

      <view class="section travel-section">
        <view class="section-head">
          <view class="section-title">选择出发日期</view>
          <button class="travel-action" bindtap="openTravelDrawer">选择日期</button>
        </view>
        <view wx:if="{{selectedTravelDateText}}" class="travel-selected">
          已选 {{selectedTravelDateText}} · {{selectedTravelPriceText}}
        </view>
        <view wx:else class="travel-selected travel-selected-muted">请选择出行日期和对应价格</view>
      </view>

      <view wx:if="{{detailImages.length > 0}}" class="detail-images-section">
        <view class="section-title">产品详情</view>
        <image
          wx:for="{{detailImages}}"
          wx:key="*this"
          class="detail-image"
          src="{{item}}"
          mode="widthFix"
          show-menu-by-longpress
        />
      </view>

      <view class="section">
        <view class="section-title">行程介绍</view>
        <text class="section-text">{{product.itinerary}}</text>
      </view>
      <view class="section">
        <view class="section-title">费用说明</view>
        <text class="section-text">{{product.feeDescription}}</text>
      </view>
      <view class="section">
        <view class="section-title">出行须知</view>
        <text class="section-text">{{product.travelNotice}}</text>
      </view>
      <view wx:if="{{product.refundPolicy}}" class="section">
        <view class="section-title">退款说明</view>
        <text class="section-text">{{product.refundPolicy}}</text>
      </view>
    </view>
  </scroll-view>

  <van-calendar
    class="travel-calendar"
    custom-class="travel-calendar"
    show="{{showTravelDrawer}}"
    title="选择出发日期"
    position="bottom"
    round
    close-on-click-overlay
    show-title="{{true}}"
    show-confirm="{{false}}"
    show-mark="{{false}}"
    show-subtitle="{{true}}"
    color="#57b75d"
    min-date="{{calendarMinDate}}"
    max-date="{{calendarMaxDate}}"
    default-date="{{calendarDefaultDate}}"
    formatter="{{calendarFormatter}}"
    root-portal="{{true}}"
    bind:close="closeTravelDrawer"
    bind:select="selectTravelDate"
    bind:confirm="selectTravelDate"
  />

  <view class="bottom-bar">
    <view class="tool-group">
      <view class="tool-item" bindtap="callService">
        <view class="tool-icon">客</view>
        <view class="tool-label">客服</view>
      </view>
      <view class="tool-item" bindtap="openCart">
        <view class="tool-icon tool-icon-cart">
          <text class="tool-icon-text">车</text>
          <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartBadgeText}}</view>
        </view>
        <view class="tool-label">购物车</view>
      </view>
    </view>

    <view class="cta-group">
      <button class="cta-button cta-cart" loading="{{actionLoading}}" bindtap="addToCart">加入购物车</button>
      <button class="cta-button cta-buy" loading="{{actionLoading}}" bindtap="reserve">立即购买</button>
    </view>
  </view>
</view>
