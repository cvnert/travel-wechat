.detail-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f5f7fb;
}

.swiper {
  height: 460rpx;
  background: #e4e7ec;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.content {
  margin: 24rpx 24rpx 56rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.06);
}

.detail-images-section {
  padding-top: 34rpx;
}

.detail-image {
  width: 100%;
  display: block;
  margin-top: 18rpx;
  background: #edf0f5;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.title {
  flex: 1;
  color: #1f2937;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #b54708;
  font-size: 22rpx;
}

.summary {
  display: -webkit-box;
  margin-top: 20rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0 24rpx;
  margin-top: 4rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.price {
  color: #f04438;
  font-size: 44rpx;
  font-weight: 800;
}

.sales {
  color: #98a2b3;
  font-size: 26rpx;
}

.section {
  padding-top: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
}

.section-text {
  color: #475467;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(16, 24, 40, 0.08);
}

.tool-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 0 auto;
}

.tool-item {
  width: 78rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tool-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #4b5563;
  border-radius: 50%;
  color: #374151;
  font-size: 20rpx;
  font-weight: 700;
  background: #ffffff;
  box-sizing: border-box;
}

.tool-icon-text {
  line-height: 1;
}

.tool-label {
  margin-top: 8rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.2;
}

.tool-icon-cart {
  overflow: visible;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.cta-group {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-radius: 999rpx;
}

.cta-button {
  flex: 1;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.cta-button::after {
  border: 0;
}

.cta-cart {
  background: #dff5dc;
  color: #57b75d;
}

.cta-buy {
  background: linear-gradient(135deg, #7ed37f 0%, #57b75d 100%);
  color: #ffffff;
}
