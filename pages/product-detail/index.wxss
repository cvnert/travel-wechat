.detail-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f5f7fb;
}

.swiper {
  height: 460rpx;
  background: #e4e7ec;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.content {
  margin: 24rpx 24rpx 56rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.06);
}

.detail-images-section {
  padding-top: 34rpx;
}

.detail-image {
  width: 100%;
  display: block;
  margin-top: 18rpx;
  background: #edf0f5;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.title {
  flex: 1;
  color: #1f2937;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #b54708;
  font-size: 22rpx;
}

.summary {
  display: -webkit-box;
  margin-top: 20rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0 24rpx;
  margin-top: 4rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.price {
  color: #f04438;
  font-size: 44rpx;
  font-weight: 800;
}

.sales {
  color: #98a2b3;
  font-size: 26rpx;
}

.section {
  padding-top: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
}

.section-text {
  color: #475467;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(16, 24, 40, 0.08);
}

.action {
  flex: 1;
  min-width: 0;
}
