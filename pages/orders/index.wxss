.orders-page {
  min-height: 100vh;
  padding: 22rpx 20rpx 34rpx;
  background:
    radial-gradient(circle at top left, rgba(255, 213, 164, 0.38), transparent 26%),
    linear-gradient(180deg, #fff8ee 0%, #f5f7fb 24%, #eef2f8 100%);
  box-sizing: border-box;
}

.tabs-shell {
  padding: 10rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.56);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(12rpx);
  margin-bottom: 20rpx;
}

.tabs {
  display: flex;
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 136rpx;
  margin-right: 10rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #667085;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  border: 1rpx solid rgba(231, 236, 244, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.05);
}

.tab-active {
  background: #172338;
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 12rpx 24rpx rgba(23, 35, 56, 0.2);
}

.empty-card {
  padding: 56rpx 32rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.97);
  text-align: center;
  color: #667085;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.08);
}

.empty-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  margin-top: 28rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.order-card {
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.08);
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.order-head-main {
  flex: 1;
  min-width: 0;
}

.order-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
}

.order-no {
  color: #475467;
  font-size: 22rpx;
  line-height: 1.5;
}

.order-meta {
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.order-hint {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.3;
}

.order-hint-warning {
  background: #fff7ed;
  color: #c2410c;
}

.order-hint-primary {
  background: #eff6ff;
  color: #1d4ed8;
}

.order-hint-success {
  background: #ecfdf3;
  color: #15803d;
}

.order-status {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.order-status-warning {
  background: #fff7ed;
  color: #ea580c;
}

.order-status-primary {
  background: #eff6ff;
  color: #2563eb;
}

.order-status-success {
  background: #ecfdf3;
  color: #16a34a;
}

.order-items {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.order-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fbfcfe;
  border: 1rpx solid #edf1f6;
}

.item-cover {
  width: 136rpx;
  height: 136rpx;
  flex: 0 0 136rpx;
  border-radius: 20rpx;
  background: #e5e7eb;
}

.item-info {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.item-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.item-meta,
.order-summary-label {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.55;
}

.item-meta {
  margin-top: 8rpx;
}

.item-side {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  min-width: 140rpx;
  padding-top: 4rpx;
}

.order-summary {
  flex: 1;
  min-width: 0;
}

.order-total {
  margin-top: 8rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.order-total-amount {
  margin-left: 8rpx;
  color: #c2410c;
}

.item-subtotal {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.order-actions {
  display: flex;
  align-items: center;
  margin-left: auto;
  flex: 0 0 auto;
}

.pay-button,
.detail-button {
  min-width: 216rpx;
  height: 84rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.pay-button {
  background: linear-gradient(135deg, #2d7ef7 0%, #2463eb 100%);
  box-shadow: 0 12rpx 22rpx rgba(37, 99, 235, 0.22);
}

.detail-button {
  background: #ffffff;
  color: #172338;
  border: 1rpx solid #d8e1ec;
}

.detail-button::after,
.pay-button::after {
  border: 0;
}
