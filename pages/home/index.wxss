page {
  background: #f4f3f1;
}

.home-page {
  min-height: 100vh;
  padding-bottom: 28rpx;
  color: #2f2a25;
  background: #f4f3f1;
}

.hero-swiper {
  width: 100%;
  height: 760rpx;
  background: #d9d7d2;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-mask {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0.04) 0%, rgba(0, 0, 0, 0.16) 42%, rgba(0, 0, 0, 0.44) 100%);
}

.hero-logo {
  position: absolute;
  right: 44rpx;
  top: 88rpx;
  pointer-events: none;
  color: rgba(255, 255, 255, 0.84);
  font-size: 40rpx;
  letter-spacing: 12rpx;
  font-family: Georgia, "Times New Roman", serif;
}

.hero-copy {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 128rpx;
  pointer-events: none;
  color: #ffffff;
}

.hero-tag {
  width: fit-content;
  margin-bottom: 14rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  color: #ffffff;
  font-size: 22rpx;
}

.hero-name {
  font-size: 46rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 600;
  line-height: 1.2;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.32);
}

.hero-desc {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.45;
}

.hero-button {
  position: absolute;
  right: 52rpx;
  bottom: 92rpx;
  pointer-events: auto;
  width: 172rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.88);
  color: #3d342d;
  font-size: 24rpx;
  line-height: 1;
}

.hero-empty {
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rpx;
  background: #e6e2dc;
}

.quick-item {
  height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #ffffff;
  color: #5a554e;
  font-size: 24rpx;
}

.quick-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #b6a66d;
  border-radius: 50%;
  color: #b6a66d;
  font-size: 22rpx;
  font-family: Georgia, "Times New Roman", serif;
}

.section-band {
  padding: 74rpx 32rpx 60rpx;
  text-align: center;
  background: #f4f3f1;
}

.section-title {
  color: #75645c;
  font-size: 52rpx;
  letter-spacing: 8rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 600;
}

.section-subtitle {
  margin-top: 16rpx;
  color: #9a958f;
  font-size: 24rpx;
}

.camp-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.camp-card {
  position: relative;
  width: 100%;
  height: 326rpx;
  overflow: hidden;
  background: #d8d5cf;
}

.camp-image {
  width: 100%;
  height: 100%;
  display: block;
}

.camp-shade {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0.58) 100%),
    linear-gradient(90deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0));
}

.camp-copy {
  position: absolute;
  left: 28rpx;
  right: 188rpx;
  bottom: 40rpx;
  pointer-events: none;
  color: #ffffff;
}

.camp-tag {
  display: inline-flex;
  margin-bottom: 12rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
}

.camp-title {
  overflow: hidden;
  font-size: 34rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.camp-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.camp-action {
  position: absolute;
  right: 26rpx;
  bottom: 54rpx;
  width: 130rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  color: #ffffff;
  font-size: 22rpx;
  pointer-events: auto;
}

.camp-price {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  padding: 8rpx 14rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #75633d;
  font-size: 24rpx;
  pointer-events: none;
}

.camp-sales {
  position: absolute;
  left: 28rpx;
  top: 28rpx;
  padding: 6rpx 12rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  font-size: 22rpx;
  pointer-events: none;
}

.empty {
  padding: 110rpx 32rpx;
  text-align: center;
  color: #9b9690;
  font-size: 28rpx;
}

.bottom-spacer {
  height: 40rpx;
}
